# Secrets and local environment settings
.env
.env.*
!.env.example
frontend/.runtime/

# Local application interfaces (keep on disk, exclude from GitHub)
/frontend/
/api/*
!/api/__init__.py
!/api/server.py
!/api/runtime.py
!/api/Dockerfile
!/api/Dockerfile.dockerignore

# Downloaded benchmark tool database
/benchmarks/travelplanner/database/

# Golden benchmark dataset is published separately on Hugging Face
/benchmarks/vistra-v1/golden/
/benchmarks/scripts/build_golden_set.py
/benchmarks/scripts/golden_catalog.py
/benchmarks/scripts/golden_conversations.py
/benchmarks/scripts/golden_planning_failures.py

# Publish only readable reports and aggregate metrics from benchmark runs.
# Raw outputs can contain golden prompts, answers and retrieved evidence.
/benchmarks/runs/**/*
!/benchmarks/runs/**/
!/benchmarks/runs/**/*.md
!/benchmarks/runs/**/summary.json
!/benchmarks/runs/**/cost.json
!/benchmarks/runs/**/costs.json
!/benchmarks/runs/**/pricing.json

# Generated benchmark detail; retain reports, summaries, code and fixtures
/benchmarks/runs/**/attempts/
/benchmarks/runs/**/cases/
/benchmarks/runs/**/checkpoints/
/benchmarks/runs/**/logs/
/benchmarks/runs/**/transport/
/benchmarks/runs/**/transport-usage/
/benchmarks/runs/**/preflight-transport/
/benchmarks/runs/**/preflight-config.yaml
/benchmarks/runs/**/status.json

# Python environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Model downloads and tool caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local datasets and databases
datasets/
databases/
outputs/

# Local database files
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Local inspiration photos; documentation images remain available to Git
/*.jpg
/*.jpeg
/*.webp

# Python build and coverage output
/build/
/dist/
*.egg-info/
.coverage
.coverage.*
/htmlcov/
coverage.xml

# OpenAPI is generated by the developer API at /openapi.json.
/api/openapi.json

# Local editor settings, logs, and operating system files
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db
Desktop.ini
