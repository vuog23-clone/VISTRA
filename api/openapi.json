{
  "openapi": "3.1.0",
  "info": {
    "title": "VISTRA Developer API",
    "description": "Use X-API-Key with /v1/chat. Reuse user_id and session_id for multi-turn memory.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Process liveness; no model loads or database/provider calls.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Chat",
        "operationId": "chat_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key"
          },
          "409": {
            "description": "User busy or memory conflict"
          },
          "429": {
            "description": "API capacity reached"
          },
          "503": {
            "description": "Backend unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.@:-]{1,128}$",
            "title": "User Id",
            "description": "Your application's user identifier."
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.@:-]{1,128}$",
            "title": "Session Id",
            "description": "Reuse for follow-up messages."
          },
          "message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Message"
          },
          "retrieval_limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Retrieval Limit",
            "default": 20
          },
          "response_mode": {
            "type": "string",
            "enum": [
              "auto",
              "retrieval",
              "llm_only"
            ],
            "title": "Response Mode",
            "default": "auto"
          },
          "route": {
            "type": "string",
            "enum": [
              "auto",
              "text",
              "hybrid"
            ],
            "title": "Route",
            "default": "auto"
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Location",
            "description": "Optional destination override. Omit to detect it from the conversation."
          },
          "retrieve_only": {
            "type": "boolean",
            "title": "Retrieve Only",
            "default": false
          },
          "include_weather": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Include Weather"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date",
            "description": "Optional trip start in YYYY-MM-DD format. Supply with end_date, or omit both."
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date",
            "description": "Optional trip end in YYYY-MM-DD format. Supply with start_date, at most 14 inclusive days."
          },
          "planning_mode": {
            "type": "string",
            "enum": [
              "auto",
              "off"
            ],
            "title": "Planning Mode",
            "default": "auto"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "session_id",
          "message"
        ],
        "title": "ChatRequest",
        "examples": [
          {
            "message": "Who are you?",
            "session_id": "example-session",
            "user_id": "customer-123"
          }
        ]
      },
      "ChatResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "answer_format": {
            "type": "string",
            "title": "Answer Format",
            "default": "markdown"
          },
          "pipeline_status": {
            "type": "string",
            "title": "Pipeline Status"
          },
          "response_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Mode"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "memory_status": {
            "type": "string",
            "title": "Memory Status"
          },
          "sources": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Sources"
          },
          "retrieval": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieval"
          },
          "weather": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weather"
          },
          "itinerary": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Itinerary"
          },
          "planning": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planning"
          },
          "elapsed_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Elapsed Seconds"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "session_id",
          "answer",
          "pipeline_status",
          "version",
          "memory_status"
        ],
        "title": "ChatResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}